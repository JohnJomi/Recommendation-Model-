# PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/musicdb

# Spotify OAuth Configuration
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/callback

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000

# Production notes:
# - Update DATABASE_URL to point to production PostgreSQL instance
# - Register SPOTIFY_REDIRECT_URI in Spotify Developer Dashboard
# - Update FRONTEND_URL to production domain
# - Update ALLOWED_ORIGINS to production domain
# - Use environment-specific .env.production file
